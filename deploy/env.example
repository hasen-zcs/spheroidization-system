# 球化监测系统 · 环境变量示例
# 用法：cp deploy/env.example /opt/spheroidization/env && 改值
# systemd unit 里 EnvironmentFile 指到它。所有项都有代码默认值，按需改。
# 注意：本文件不含任何密码；管理员密码只在安装时给一次（env 或 getpass）。

# ---------- 数据库 ----------
# 库文件路径。不写则默认 <项目根>/data/spheroidization.db
SPHEROIDIZATION_DB=/opt/spheroidization/data/spheroidization.db
# active_standard.json 固定与库同目录，无单独变量

# ---------- API 服务 ----------
# 健康检查用的地址/端口（healthcheck.sh 读取；uvicorn 端口在 unit 的 ExecStart 里）
SPHEROIDIZATION_HOST=127.0.0.1
SPHEROIDIZATION_PORT=8000
# 跨域白名单（逗号分隔）。同源部署时前端走后端，基本不用改
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 视频流反代目标（/api/video_feed1|2 → 该地址，默认 127.0.0.1:5080）
VIDEO_FEED_BASE=http://127.0.0.1:5080

# ---------- 安装/部署辅助（install.sh / backup.sh 用，运行期不需要） ----------
# 首个管理员（install.sh）
ADMIN_USERNAME=admin
# 标准初值（install.sh 播种用，仅新库标准表为空时生效）
SEED_STANDARD_TIME=75
SEED_STANDARD_TIME_UPPER=90
SEED_STANDARD_TIME_LOWER=60
SEED_STANDARD_WEIGHING=1800
# 备份目录与保留份数（backup.sh）
SPHEROIDIZATION_BACKUP_DIR=/opt/spheroidization/data/backups
BACKUP_KEEP=10

# ---------- 合并层（merge service） ----------
# 现场数据根目录（东贝现场默认 /root/MR，换机器必改）
MERGE_ROOT=/root/MR
# 输入文件（有默认值，都在 MERGE_ROOT 下；路径特殊时逐项覆盖）
#MERGE_VPMIN_FILE=/root/MR/reactions.jsonl
#MERGE_PLC_ALL=/root/MR/all_plc.jsonl
#MERGE_PLC_ROLLING=/root/MR/plc.jsonl
#MERGE_TEMP_ALL=/root/MR/all_temperature.jsonl
#MERGE_TEMP_DIR=/root/MR/temperture_guns
#MERGE_BUTTON_FILE=/root/MR/button_confirm/all_button_confirm_time.jsonl
#MERGE_HEAT_FILE=/root/MR/output/plc/heat_records.jsonl
# 主数据源：heat（一行一炉，默认）| reactions（亮光+PLC 配对老路径）
MERGE_SOURCE=heat
# 状态库 / 日志 / 死信预览（注意：MERGE_LOG 是 logrotate 盯的那个文件）
MERGE_STATE_DB=/root/MR/merge_state.db
MERGE_LOG=/root/MR/merge_service.log
MERGE_DRYRUN_OUT=/root/MR/merge_dryrun.jsonl
# 后端地址与设备标识（幂等键的一半，一台机器只能一个值，改了等于换设备）
MERGE_BACKEND=http://127.0.0.1:8000
MERGE_DEVICE_ID=casting-1
# 配对窗口（秒）/ 温度枪白名单 / 保护与重试
MERGE_LIGHT_AFTER_BTN=300
MERGE_LIGHT_BEFORE_BTN=60
MERGE_LIGHT_BEFORE_FEED=30
MERGE_LIGHT_AFTER_FEED=60
MERGE_TEMP_WINDOW=600
MERGE_TEMP_GUNS=4
MERGE_NO_PLC_GUARD=3
MERGE_GUARD_PAUSE=600
MERGE_PENDING_TTL=86400
MERGE_RETRY_MAX=60
MERGE_DEAD_AFTER=86400
MERGE_POLL=2
MERGE_HTTP_TIMEOUT=20

# ---------- vpmin 检测服务 ----------
# vpmin 自己的参数放独立文件 /etc/spheroidization/vpmin.env（见 vpmin.service），
# 相机/阈值类参数不在本文件里管理。
